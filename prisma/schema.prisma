// BookMyArtist — Artist booking & agency management platform.
//
// Conventions (see docs/ARCHITECTURE.md §4):
// - UUID primary keys, generated by Postgres.
// - All timestamps are `timestamptz` and stored in UTC. Display in Asia/Kolkata.
// - Money is stored as BigInt minor units (paise) in columns suffixed `Paise`.
//   Never use floats for money. Percentages are stored in basis points (Bps).
// - Business history is never hard-deleted: records are archived, voided,
//   cancelled or superseded instead.
// - Confidential artist data lives in `ArtistInternal`, never on `Artist`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique // stored lower-cased
  name               String
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  roleId             String     @db.Uuid
  role               Role       @relation(fields: [roleId], references: [id])
  phone              String?
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  failedLoginCount   Int        @default(0)
  // Set for accounts created/reset with a temporary password; cleared when the user sets their own.
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  // Soft delete: the row stays so history (notes, timeline, audit) keeps its author.
  deletedAt          DateTime?  @db.Timestamptz(3)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  // Reserved for the future artist/partner portal.
  artistId           String?    @unique @db.Uuid
  artist             Artist?    @relation("ArtistPortalUser", fields: [artistId], references: [id])
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  sessions          Session[]
  ownedEnquiries    Enquiry[]          @relation("EnquiryOwner")
  ownedBookings     Booking[]          @relation("BookingOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  notifications     Notification[]
  enquiryNotes      EnquiryNote[]
  enquiryActivities EnquiryActivity[]
  bookingActivities BookingActivity[]
  auditLogs         AuditLog[]
  recordedPayments  Payment[]          @relation("PaymentRecorder")
  recordedPayouts   ArtistPayout[]     @relation("PayoutRecorder")
  recordedExpenses  Expense[]          @relation("ExpenseRecorder")
  uploadedFiles     FileAsset[]
  quotationVersions QuotationVersion[]

  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. SUPER_ADMIN
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. "enquiry:write"
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  // SHA-256 of the random session token. The raw token only exists in the cookie.
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────────────── Artists ───────────────────────────────────

enum ArtistStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  ARCHIVED
}

/// Event types double as the public "services" taxonomy.
enum EventType {
  WEDDING
  CORPORATE
  COLLEGE_FESTIVAL
  PRIVATE_PARTY
  CONCERT
  CULTURAL
  FESTIVAL
  BRAND_ACTIVATION
  OTHER
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

model ArtistCategory {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  artists     Artist[]
  enquiries   Enquiry[]
}

/// Public-facing artist profile. Everything here may be rendered publicly
/// when `status = ACTIVE`. Confidential data lives in `ArtistInternal`.
model Artist {
  id                     String         @id @default(uuid()) @db.Uuid
  slug                   String         @unique
  stageName              String
  categoryId             String         @db.Uuid
  category               ArtistCategory @relation(fields: [categoryId], references: [id])
  tagline                String?
  shortBio               String
  biography              String
  performanceDescription String?
  profileImageUrl        String?
  coverImageUrl          String?
  languages              String[]
  baseCity               String
  performanceTypes       String[]
  eventTypes             EventType[]
  technicalRequirements  String?
  teamSize               Int?
  minDurationMinutes     Int?
  maxDurationMinutes     Int?
  // Public pricing is shown only when explicitly approved.
  publicPriceVisible     Boolean        @default(false)
  publicPriceFromPaise   BigInt?
  publicPriceNote        String?
  // Public contact is shown only when explicitly approved.
  publicContactApproved  Boolean        @default(false)
  publicEmail            String?
  publicPhone            String?
  // "Available" badge is shown only for dates the agency has verified.
  availabilityVerifiedAt DateTime?      @db.Timestamptz(3)
  status                 ArtistStatus   @default(ACTIVE)
  isFeatured             Boolean        @default(false)
  featuredOrder          Int            @default(0)
  seoTitle               String?
  seoDescription         String?
  isDemo                 Boolean        @default(false) // seeded demo content
  archivedAt             DateTime?      @db.Timestamptz(3)
  createdById            String?        @db.Uuid
  updatedById            String?        @db.Uuid
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  internal        ArtistInternal?
  media           ArtistMedia[]
  availability    ArtistAvailability[]
  blackouts       ArtistBlackout[]
  enquiryLinks    EnquiryArtist[]
  sourceEnquiries Enquiry[]            @relation("EnquirySourceArtist")
  bookingLinks    BookingArtist[]
  payouts         ArtistPayout[]
  quotationItems  QuotationItem[]
  files           FileAsset[]
  testimonials    Testimonial[]
  portalUser      User?                @relation("ArtistPortalUser")

  @@index([status, isFeatured])
  @@index([categoryId, status])
  @@index([baseCity])
  @@index([stageName(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Confidential, admin-only artist data. Never selected by public services.
model ArtistInternal {
  artistId             String         @id @db.Uuid
  artist               Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  legalName            String?
  contactEmail         String?
  contactPhone         String?
  managerName          String?
  managerPhone         String?
  basePricePaise       BigInt?
  commissionType       CommissionType @default(PERCENTAGE)
  commissionRateBps    Int?           @default(2000) // used when PERCENTAGE (2000 = 20%)
  commissionFixedPaise BigInt? // used when FIXED
  bankDetailsNote      String? // free-text reference only; never store full card data
  internalNotes        String?
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaProvider {
  CLOUDINARY
  YOUTUBE
  VIMEO
  EXTERNAL
}

model ArtistMedia {
  id           String        @id @default(uuid()) @db.Uuid
  artistId     String        @db.Uuid
  artist       Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  type         MediaType
  provider     MediaProvider @default(CLOUDINARY)
  url          String
  providerId   String? // Cloudinary public_id or video id
  thumbnailUrl String?
  title        String?
  alt          String?
  width        Int?
  height       Int?
  durationSec  Int?
  sortOrder    Int           @default(0)
  isPublic     Boolean       @default(true)
  isShowcase   Boolean       @default(false) // eligible for the homepage gallery
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([artistId, type, sortOrder])
  @@index([isShowcase])
}

enum AvailabilityType {
  AVAILABLE // agency-verified free window
  TENTATIVE_HOLD // soft hold for an enquiry; never treated as a reservation
}

model ArtistAvailability {
  id          String           @id @default(uuid()) @db.Uuid
  artistId    String           @db.Uuid
  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  type        AvailabilityType
  startsAt    DateTime         @db.Timestamptz(3)
  endsAt      DateTime         @db.Timestamptz(3)
  enquiryId   String?          @db.Uuid
  enquiry     Enquiry?         @relation(fields: [enquiryId], references: [id])
  note        String?
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  releasedAt  DateTime?        @db.Timestamptz(3)

  @@index([artistId, startsAt, endsAt])
}

/// Hard unavailability (personal commitments, travel, direct bookings).
model ArtistBlackout {
  id          String    @id @default(uuid()) @db.Uuid
  artistId    String    @db.Uuid
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  startsAt    DateTime  @db.Timestamptz(3)
  endsAt      DateTime  @db.Timestamptz(3)
  reason      String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  @@index([artistId, startsAt, endsAt])
}

// ───────────────────────────────── Clients ───────────────────────────────────

enum ClientType {
  INDIVIDUAL
  CORPORATE
  COLLEGE
  EVENT_PLANNER
  AGENCY
  VENUE
  OTHER
}

model Client {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String? // lower-cased
  phone        String? // E.164
  organization String?
  type         ClientType @default(INDIVIDUAL)
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String     @default("IN")
  taxId        String? // e.g. GSTIN, captured as provided; not validated
  notes        String?
  archivedAt   DateTime?  @db.Timestamptz(3)
  createdById  String?    @db.Uuid
  updatedById  String?    @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  enquiries  Enquiry[]
  bookings   Booking[]
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  files      FileAsset[]

  @@index([email])
  @@index([phone])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ──────────────────────────────── Enquiries ──────────────────────────────────

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  LOST
  CANCELLED
}

enum EnquirySource {
  BOOKING_FORM
  ARTIST_PROFILE
  SERVICE_PAGE
  CONTACT_PAGE
  ADMIN_MANUAL
  PHONE
  WHATSAPP
  EMAIL
  REFERRAL
  SOCIAL
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LostReason {
  BUDGET
  ARTIST_UNAVAILABLE
  DATE_CHANGED
  CHOSE_COMPETITOR
  NO_RESPONSE
  EVENT_CANCELLED
  NOT_A_FIT
  SPAM
  OTHER
}

model Enquiry {
  id                     String          @id @default(uuid()) @db.Uuid
  reference              String          @unique // ENQ-2026-000123
  status                 EnquiryStatus   @default(NEW)
  priority               Priority        @default(MEDIUM)
  source                 EnquirySource
  sourcePath             String?
  sourceArtistId         String?         @db.Uuid
  sourceArtist           Artist?         @relation("EnquirySourceArtist", fields: [sourceArtistId], references: [id])
  sourceService          EventType?
  ownerId                String?         @db.Uuid
  owner                  User?           @relation("EnquiryOwner", fields: [ownerId], references: [id])
  clientId               String?         @db.Uuid
  client                 Client?         @relation(fields: [clientId], references: [id])
  // Contact snapshot as submitted (the client record may later change).
  contactName            String
  contactEmail           String
  contactPhone           String
  organization           String?
  // Event details
  eventType              EventType
  eventDate              DateTime        @db.Date
  eventCity              String
  venue                  String?
  audienceSize           Int?
  // Entertainment requirements
  categoryId             String?         @db.Uuid
  category               ArtistCategory? @relation(fields: [categoryId], references: [id])
  performanceType        String?
  performersCount        Int?
  durationMinutes        Int?
  additionalRequirements String?
  budgetMinPaise         BigInt?
  budgetMaxPaise         BigInt?
  message                String?
  // CRM
  nextFollowUpAt         DateTime?       @db.Timestamptz(3)
  lastContactedAt        DateTime?       @db.Timestamptz(3)
  lostReason             LostReason?
  lostReasonNote         String?
  closedAt               DateTime?       @db.Timestamptz(3)
  // Submission forensics (hashed IP; never shown publicly)
  submitterIpHash        String?
  userAgent              String?
  createdById            String?         @db.Uuid
  updatedById            String?         @db.Uuid
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  artists    EnquiryArtist[]
  activities EnquiryActivity[]
  notes      EnquiryNote[]
  booking    Booking?
  quotations Quotation[]
  tasks      Task[]
  holds      ArtistAvailability[]
  files      FileAsset[]

  @@index([status, createdAt])
  @@index([eventDate])
  @@index([nextFollowUpAt])
  @@index([contactEmail])
  @@index([contactPhone])
  @@index([ownerId])
  @@index([source])
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum EnquiryArtistRole {
  PREFERRED // chosen by the customer
  SUGGESTED // proposed by the agency
  SHORTLISTED // agreed shortlist
}

model EnquiryArtist {
  enquiryId String            @db.Uuid
  artistId  String            @db.Uuid
  enquiry   Enquiry           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  artist    Artist            @relation(fields: [artistId], references: [id])
  role      EnquiryArtistRole @default(PREFERRED)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@id([enquiryId, artistId])
  @@index([artistId])
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  FOLLOW_UP_SET
  CALL
  EMAIL
  WHATSAPP
  MEETING
  QUOTATION_CREATED
  QUOTATION_SENT
  CONVERTED
  ARTIST_ASSIGNED
  ARTIST_CONFIRMED
  PAYMENT_RECORDED
  PAYOUT_RECORDED
  EXPENSE_RECORDED
  INVOICE_ISSUED
  SYSTEM
}

/// Append-only enquiry timeline (status changes, communications, edits).
model EnquiryActivity {
  id         String         @id @default(uuid()) @db.Uuid
  enquiryId  String         @db.Uuid
  enquiry    Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type       ActivityType
  summary    String
  fromStatus EnquiryStatus?
  toStatus   EnquiryStatus?
  metadata   Json?
  actorId    String?        @db.Uuid
  actor      User?          @relation(fields: [actorId], references: [id])
  occurredAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([enquiryId, occurredAt])
}

model EnquiryNote {
  id        String   @id @default(uuid()) @db.Uuid
  enquiryId String   @db.Uuid
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  body      String
  isPinned  Boolean  @default(false)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([enquiryId, createdAt])
}

// ──────────────────────────────── Bookings ───────────────────────────────────

enum BookingStatus {
  ENQUIRY
  QUOTATION
  NEGOTIATION
  CONFIRMED
  ADVANCE_RECEIVED
  ARTIST_CONFIRMED
  UPCOMING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  reference           String        @unique // BKG-2026-000045
  enquiryId           String?       @unique @db.Uuid
  enquiry             Enquiry?      @relation(fields: [enquiryId], references: [id])
  clientId            String        @db.Uuid
  client              Client        @relation(fields: [clientId], references: [id])
  ownerId             String?       @db.Uuid
  owner               User?         @relation("BookingOwner", fields: [ownerId], references: [id])
  title               String
  eventType           EventType
  eventDate           DateTime      @db.Date
  startsAt            DateTime?     @db.Timestamptz(3)
  endsAt              DateTime?     @db.Timestamptz(3)
  venueName           String?
  venueAddress        String?
  city                String
  audienceSize        Int?
  status              BookingStatus @default(ENQUIRY)
  // Agreed customer amount, excluding tax. Tax is applied on invoices.
  customerAmountPaise BigInt?
  currency            String        @default("INR")
  paymentTerms        String?
  internalNotes       String?
  confirmedAt         DateTime?     @db.Timestamptz(3)
  completedAt         DateTime?     @db.Timestamptz(3)
  cancelledAt         DateTime?     @db.Timestamptz(3)
  cancellationReason  String?
  createdById         String?       @db.Uuid
  updatedById         String?       @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  artists     BookingArtist[]
  activities  BookingActivity[]
  quotations  Quotation[]
  invoices    Invoice[]
  payments    Payment[]
  payouts     ArtistPayout[]
  expenses    Expense[]
  paymentDues PaymentDue[]
  tasks       Task[]
  files       FileAsset[]

  @@index([status, eventDate])
  @@index([eventDate])
  @@index([clientId])
}

enum ReservationStatus {
  TENTATIVE // not a reservation; never blocks other bookings
  CONFIRMED // hard reservation; protected by an exclusion constraint
  RELEASED // historic (artist removed or booking cancelled)
}

/// An artist's participation in a booking, including their agreed payout and
/// the time window they are blocked for (performance ± configured buffers).
model BookingArtist {
  id                    String            @id @default(uuid()) @db.Uuid
  bookingId             String            @db.Uuid
  booking               Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId              String            @db.Uuid
  artist                Artist            @relation(fields: [artistId], references: [id])
  performanceStartsAt   DateTime          @db.Timestamptz(3)
  performanceEndsAt     DateTime          @db.Timestamptz(3)
  setupBufferMinutes    Int               @default(0)
  travelBufferMinutes   Int               @default(0)
  teardownBufferMinutes Int               @default(0)
  // Derived: performanceStartsAt - setup - travel / performanceEndsAt + teardown + travel.
  blockedFrom           DateTime          @db.Timestamptz(3)
  blockedUntil          DateTime          @db.Timestamptz(3)
  payoutPaise           BigInt            @default(0)
  reservationStatus     ReservationStatus @default(TENTATIVE)
  artistConfirmedAt     DateTime?         @db.Timestamptz(3)
  releasedAt            DateTime?         @db.Timestamptz(3)
  notes                 String?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  payouts     ArtistPayout[]
  paymentDues PaymentDue[]

  @@unique([bookingId, artistId])
  @@index([artistId, blockedFrom, blockedUntil])
}

model BookingActivity {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @db.Uuid
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type       ActivityType
  summary    String
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  metadata   Json?
  actorId    String?        @db.Uuid
  actor      User?          @relation(fields: [actorId], references: [id])
  occurredAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([bookingId, occurredAt])
}

// ─────────────────────────────── Quotations ──────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model Quotation {
  id             String          @id @default(uuid()) @db.Uuid
  number         String          @unique // QT-2026-000012
  status         QuotationStatus @default(DRAFT)
  enquiryId      String?         @db.Uuid
  enquiry        Enquiry?        @relation(fields: [enquiryId], references: [id])
  bookingId      String?         @db.Uuid
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  clientId       String          @db.Uuid
  client         Client          @relation(fields: [clientId], references: [id])
  currentVersion Int             @default(1)
  acceptedAt     DateTime?       @db.Timestamptz(3)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  versions QuotationVersion[]

  @@index([status])
  @@index([enquiryId])
  @@index([bookingId])
}

/// Immutable once sent. Editing a sent quotation creates a new version.
/// Contains only customer-facing pricing: never artist payout or margin.
model QuotationVersion {
  id               String    @id @default(uuid()) @db.Uuid
  quotationId      String    @db.Uuid
  quotation        Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  version          Int
  // Snapshot of customer + event details at the time of this version.
  customerSnapshot Json
  eventSnapshot    Json
  subtotalPaise    BigInt
  discountPaise    BigInt    @default(0)
  taxPaise         BigInt    @default(0)
  totalPaise       BigInt
  validUntil       DateTime  @db.Date
  paymentTerms     String?
  terms            String?
  notes            String?
  sentAt           DateTime? @db.Timestamptz(3)
  createdById      String?   @db.Uuid
  createdBy        User?     @relation(fields: [createdById], references: [id])
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  items QuotationItem[]

  @@unique([quotationId, version])
}

model QuotationItem {
  id                 String           @id @default(uuid()) @db.Uuid
  quotationVersionId String           @db.Uuid
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  artistId           String?          @db.Uuid
  artist             Artist?          @relation(fields: [artistId], references: [id])
  description        String
  details            String?
  quantity           Int              @default(1)
  unitPricePaise     BigInt
  discountPaise      BigInt           @default(0)
  taxRateBps         Int              @default(0)
  taxLabel           String?
  amountPaise        BigInt // quantity * unit - discount (pre-tax)
  sortOrder          Int              @default(0)

  @@index([quotationVersionId, sortOrder])
}

// ─────────────────────────── Invoices & payments ─────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  number          String?       @unique // assigned on issue: INV-2026-000031
  status          InvoiceStatus @default(DRAFT)
  bookingId       String        @db.Uuid
  booking         Booking       @relation(fields: [bookingId], references: [id])
  clientId        String        @db.Uuid
  client          Client        @relation(fields: [clientId], references: [id])
  billingSnapshot Json
  issueDate       DateTime?     @db.Date
  dueDate         DateTime?     @db.Date
  subtotalPaise   BigInt
  discountPaise   BigInt        @default(0)
  taxPaise        BigInt        @default(0)
  totalPaise      BigInt
  notes           String?
  terms           String?
  voidedAt        DateTime?     @db.Timestamptz(3)
  voidReason      String?
  createdById     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  items    InvoiceItem[]
  payments Payment[]

  @@index([bookingId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPricePaise BigInt
  discountPaise  BigInt  @default(0)
  taxRateBps     Int     @default(0)
  taxLabel       String?
  amountPaise    BigInt
  sortOrder      Int     @default(0)

  @@index([invoiceId, sortOrder])
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  RAZORPAY
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOID
}

/// Customer collections and refunds. Amounts are always positive; `kind`
/// carries the direction. Rows are voided, never deleted.
model Payment {
  id               String            @id @default(uuid()) @db.Uuid
  receiptNumber    String            @unique // RCP-2026-000088
  kind             PaymentKind       @default(PAYMENT)
  status           TransactionStatus @default(COMPLETED)
  bookingId        String            @db.Uuid
  booking          Booking           @relation(fields: [bookingId], references: [id])
  invoiceId        String?           @db.Uuid
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  clientId         String            @db.Uuid
  client           Client            @relation(fields: [clientId], references: [id])
  amountPaise      BigInt
  method           PaymentMethod
  transactionRef   String?
  gatewayOrderId   String?           @unique
  gatewayPaymentId String?           @unique
  receivedAt       DateTime          @db.Timestamptz(3)
  notes            String?
  voidedAt         DateTime?         @db.Timestamptz(3)
  voidReason       String?
  recordedById     String?           @db.Uuid
  recordedBy       User?             @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  @@index([bookingId, status])
  @@index([receivedAt])
}

enum PayoutKind {
  PAYOUT
  REVERSAL
}

model ArtistPayout {
  id              String            @id @default(uuid()) @db.Uuid
  reference       String            @unique // PAY-2026-000019
  kind            PayoutKind        @default(PAYOUT)
  status          TransactionStatus @default(COMPLETED)
  bookingArtistId String            @db.Uuid
  bookingArtist   BookingArtist     @relation(fields: [bookingArtistId], references: [id])
  bookingId       String            @db.Uuid
  booking         Booking           @relation(fields: [bookingId], references: [id])
  artistId        String            @db.Uuid
  artist          Artist            @relation(fields: [artistId], references: [id])
  amountPaise     BigInt
  method          PaymentMethod
  transactionRef  String?
  paidAt          DateTime          @db.Timestamptz(3)
  notes           String?
  voidedAt        DateTime?         @db.Timestamptz(3)
  voidReason      String?
  recordedById    String?           @db.Uuid
  recordedBy      User?             @relation("PayoutRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([bookingId, status])
  @@index([artistId, paidAt])
}

enum DueDirection {
  RECEIVABLE // customer owes the agency
  PAYABLE // agency owes an artist
}

/// Planned instalments (advance, balance) used for due-date tracking.
/// Paid status is derived by comparing against actual Payment/ArtistPayout rows.
model PaymentDue {
  id              String         @id @default(uuid()) @db.Uuid
  bookingId       String         @db.Uuid
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction       DueDirection
  bookingArtistId String?        @db.Uuid
  bookingArtist   BookingArtist? @relation(fields: [bookingArtistId], references: [id])
  label           String // e.g. "Advance (50%)"
  amountPaise     BigInt
  dueDate         DateTime       @db.Date
  sortOrder       Int            @default(0)
  cancelledAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([direction, dueDate])
  @@index([bookingId])
}

enum ExpenseCategory {
  TRAVEL
  ACCOMMODATION
  LOGISTICS
  EQUIPMENT
  SOUND_AND_LIGHTS
  HOSPITALITY
  MARKETING
  OFFICE
  OTHER
}

/// Expenses linked to a booking reduce that booking's net profit.
/// Unlinked expenses are agency overheads.
model Expense {
  id             String            @id @default(uuid()) @db.Uuid
  reference      String            @unique // EXP-2026-000007
  status         TransactionStatus @default(COMPLETED)
  bookingId      String?           @db.Uuid
  booking        Booking?          @relation(fields: [bookingId], references: [id])
  category       ExpenseCategory
  description    String
  vendor         String?
  amountPaise    BigInt
  method         PaymentMethod?
  transactionRef String?
  incurredAt     DateTime          @db.Timestamptz(3)
  receiptFileId  String?           @db.Uuid
  receiptFile    FileAsset?        @relation(fields: [receiptFileId], references: [id])
  voidedAt       DateTime?         @db.Timestamptz(3)
  voidReason     String?
  recordedById   String?           @db.Uuid
  recordedBy     User?             @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([bookingId])
  @@index([incurredAt])
}

// ───────────────────────────── Tasks & alerts ────────────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  title          String
  description    String?
  status         TaskStatus @default(OPEN)
  priority       Priority   @default(MEDIUM)
  dueAt          DateTime?  @db.Timestamptz(3)
  enquiryId      String?    @db.Uuid
  enquiry        Enquiry?   @relation(fields: [enquiryId], references: [id])
  bookingId      String?    @db.Uuid
  booking        Booking?   @relation(fields: [bookingId], references: [id])
  assigneeId     String?    @db.Uuid
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String?    @db.Uuid
  createdBy      User?      @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt    DateTime?  @db.Timestamptz(3)
  reminderSentAt DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String // e.g. "enquiry.new"
  title       String
  body        String?
  href        String?
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([recipientId, readAt, createdAt])
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED // provider not configured
}

/// Transactional email outbox. Business writes enqueue rows in the same
/// transaction; delivery happens afterwards and is retried with backoff, so
/// an email failure can never lose an enquiry.
model EmailMessage {
  id                String      @id @default(uuid()) @db.Uuid
  template          String
  toAddress         String
  subject           String
  payload           Json
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @db.Timestamptz(3)
  lastError         String?
  providerMessageId String?
  entityType        String?
  entityId          String?     @db.Uuid
  sentAt            DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
}

// ───────────────────────────── Files & content ───────────────────────────────

enum FileCategory {
  CONTRACT
  RIDER
  INVOICE_PDF
  RECEIPT
  ID_DOCUMENT
  OTHER
}

/// Private documents (contracts, receipts). Served only through an
/// authorised route that issues short-lived signed URLs.
model FileAsset {
  id              String       @id @default(uuid()) @db.Uuid
  category        FileCategory
  storageProvider String       @default("cloudinary")
  storageKey      String       @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksumSha256  String?
  artistId        String?      @db.Uuid
  artist          Artist?      @relation(fields: [artistId], references: [id])
  bookingId       String?      @db.Uuid
  booking         Booking?     @relation(fields: [bookingId], references: [id])
  enquiryId       String?      @db.Uuid
  enquiry         Enquiry?     @relation(fields: [enquiryId], references: [id])
  clientId        String?      @db.Uuid
  client          Client?      @relation(fields: [clientId], references: [id])
  uploadedById    String?      @db.Uuid
  uploadedBy      User?        @relation(fields: [uploadedById], references: [id])
  archivedAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  expenses Expense[]

  @@index([artistId])
  @@index([bookingId])
}

model Testimonial {
  id          String     @id @default(uuid()) @db.Uuid
  quote       String
  authorName  String
  authorRole  String? // "Bride, Udaipur wedding"
  eventType   EventType?
  artistId    String?    @db.Uuid
  artist      Artist?    @relation(fields: [artistId], references: [id])
  rating      Int? // 1-5
  isPublished Boolean    @default(false)
  isDemo      Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([isPublished, sortOrder])
}

// ───────────────────────────── System & audit ────────────────────────────────

/// Append-only audit trail for security- and finance-relevant changes.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "payment.recorded"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Singleton row (id = 1) with agency-wide configuration.
model BusinessSettings {
  id                     Int      @id @default(1)
  agencyName             String
  legalName              String?
  email                  String?
  phone                  String?
  whatsapp               String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String   @default("IN")
  taxId                  String?
  logoUrl                String?
  currency               String   @default("INR")
  timezone               String   @default("Asia/Kolkata")
  enquiryNotifyEmails    String[]
  /// E.164 numbers that get a WhatsApp alert for each new enquiry.
  enquiryNotifyWhatsapp  String[] @default([])
  defaultSetupMinutes    Int      @default(60)
  defaultTravelMinutes   Int      @default(60)
  defaultTeardownMinutes Int      @default(30)
  taxEnabled             Boolean  @default(false)
  defaultTaxRateBps      Int      @default(0)
  taxLabel               String?
  quotationValidityDays  Int      @default(14)
  quotationTerms         String?
  invoiceTerms           String?
  paymentInstructions    String?
  updatedById            String?  @db.Uuid
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

/// Outbound WhatsApp (Cloud API template messages). Same outbox pattern as
/// EmailMessage: queued in the business transaction, delivered afterwards with
/// retries, SKIPPED when the provider isn't configured.
model WhatsAppMessage {
  id                String      @id @default(uuid()) @db.Uuid
  template          String // our template key, e.g. "enquiry.new"
  toNumber          String // E.164
  payload           Json
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @db.Timestamptz(3)
  lastError         String?
  providerMessageId String?
  entityType        String?
  entityId          String?     @db.Uuid
  sentAt            DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
}

/// Gap-free, per-year counters for human-readable references.
model DocumentSequence {
  key   String @id // e.g. "ENQ-2026"
  value Int    @default(0)
}

/// Fixed-window rate-limit counters (serverless-safe; no Redis required).
model RateLimitBucket {
  key         String   @id // "<scope>:<identifierHash>:<windowStart>"
  count       Int      @default(0)
  windowStart DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
