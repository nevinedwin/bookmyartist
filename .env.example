# ──────────────────────────────────────────────────────────────────────────────
# Encore environment variables. Copy to `.env` for local development.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.
# ──────────────────────────────────────────────────────────────────────────────

# Database (local: `npm run db:up` starts Postgres 17 on port 5433)
# Runtime connection — on Neon use the *pooled* connection string.
DATABASE_URL="postgresql://encore:encore_dev_password@localhost:5433/encore_local"
# Migrations — on Neon use the *direct* (non-pooled) connection string.
DIRECT_DATABASE_URL="postgresql://encore:encore_dev_password@localhost:5433/encore_local"
# Optional: integration/e2e tests (must contain "test" in the database name)
# TEST_DATABASE_URL="postgresql://encore:encore_dev_password@localhost:5433/encore_test"

# Secret used for HMAC signing (form tokens, IP hashing). 32+ random chars.
# Generate: openssl rand -base64 48
APP_SECRET=""

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public contact details shown on the website (optional)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# Email (Resend). Without these, emails are queued and marked SKIPPED — never faked.
RESEND_API_KEY=""
EMAIL_FROM=""            # e.g. "Encore <bookings@yourdomain.com>" (verified domain)
EMAIL_REPLY_TO=""

# WhatsApp alerts to staff (Meta WhatsApp Cloud API). Without the token and phone number ID,
# alerts are queued and marked SKIPPED. Recipients are set in Admin → Alert settings.
# The template must be approved in WhatsApp Manager — see docs/DEPLOYMENT.md §9.
WHATSAPP_ACCESS_TOKEN=""          # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=""       # from WhatsApp Manager → API setup (not the phone number itself)
WHATSAPP_TEMPLATE_NEW_ENQUIRY=""  # default "new_enquiry"
WHATSAPP_TEMPLATE_LANGUAGE=""     # default "en"

# Anti-bot (Cloudflare Turnstile). Optional — honeypot + timing + rate limits always apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Vercel Cron authorisation for /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=""

# Seeding (development/preview only)
SEED_DEMO="false"        # "true" seeds fictional demo artists; refused in production
SEED_AGENCY_EMAIL=""     # receives new-enquiry notifications (stored in Business Settings)

# ── Later phases (not used yet) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SENTRY_DSN=""
